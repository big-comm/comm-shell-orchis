#!/usr/bin/env bash

# Color definitions for status messages
blueDark="\e[1;38;5;33m"     # Bold dark blue
mediumBlue="\e[1;38;5;32m"   # Bold medium blue
lightBlue="\e[1;38;5;39m"    # Bold light blue
cyan="\e[1;38;5;45m"         # Bold cyan
white="\e[1;97m"             # Bold white
reset="\e[0m"                # Reset text formatting

# Print status messages
printMsg() {
    local message=$1
    echo -e "${blueDark}[${lightBlue}comm-shell-orchis${blueDark}]${reset} ${cyan}→${reset} ${white}${message}${reset}"
}

# Get the current non-root user
CURRENT_USER=$(who | awk 'NR==1{print $1}')

# Function executed before package installation
# pre_install() {
#     printMsg "Preparing to install the package..."
#     # Example: Check for system dependencies
#     # if ! command -v required_command &> /dev/null; then
#     #     printMsg "Error: required_command not found. Please install it before continuing."
#     #     exit 1
#     # fi
# }

# Function executed after package installation
post_install() {
    if [ -n "$CURRENT_USER" ]; then
        user_home="/home/$CURRENT_USER"
        
        # Create gtk-4.0 directory if it doesn't exist
        printMsg "Creating GTK4 configuration directory..."
        mkdir -p "$user_home/.config/gtk-4.0"
        
        # Create symbolic links for themes
        printMsg "Setting up GTK4 theme symlinks..."
        themes=("Big-Blue" "Big-Purple" "Big-Pink" "Big-Red" "Big-Orange" "Big-Yellow" "Big-Green" "Big-Teal" "Big-Grey")
        
        for theme in "${themes[@]}"; do
            if [ -d "/usr/share/themes/$theme-Light/gtk-4.0" ]; then
                # Remove old link if exists
                rm -f "$user_home/.config/gtk-4.0/$(basename "$theme")"
                # Create new link
                ln -sf "/usr/share/themes/$theme-Light/gtk-4.0" "$user_home/.config/gtk-4.0/$theme"
                printMsg "Linked theme: $theme"
            fi
        done
        
        # Fix permissions
        printMsg "Setting correct permissions..."
        chown -R $CURRENT_USER:$CURRENT_USER "$user_home/.config/gtk-4.0"
        
        printMsg "GTK4 themes configured successfully"
    else
        printMsg "Warning: No non-root user found. Skipping user-specific configuration."
    fi
}

# Function executed before package upgrade
# pre_upgrade() {
#     printMsg "Preparing to upgrade the package..."
#     # Example: Backup configuration files
#     # cp /etc/mypackage/config.conf /etc/mypackage/config.conf.bak
# }

# Function executed after package upgrade
post_upgrade() {
    printMsg "Running post-upgrade operations..."
    post_install
}

# Function executed before package removal
pre_remove() {
    if [ -n "$CURRENT_USER" ]; then
        user_home="/home/$CURRENT_USER"
        printMsg "Removing theme symlinks..."
        themes=("Big-Blue" "Big-Purple" "Big-Pink" "Big-Red" "Big-Orange" "Big-Yellow" "Big-Green" "Big-Teal" "Big-Grey")
        
        for theme in "${themes[@]}"; do
            rm -f "$user_home/.config/gtk-4.0/$theme"
            printMsg "Removed link: $theme"
        done
        
        printMsg "Theme symlinks removed successfully"
    else
        printMsg "Warning: No non-root user found. Skipping cleanup."
    fi
}

